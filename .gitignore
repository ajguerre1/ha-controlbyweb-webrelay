# Editor and assistant scratch — not part of the project history
*-local/
nimbalyst-local/

# Local-only working copies that legitimately contain real addresses and relay labels. A relay on
# this hardware is usually named after what it opens, so a captured transcript is site data even
# though it carries no credentials.
local/
captures/
*.raw.log
.env
secrets.yaml
**/secrets.local.json

